# ============================================================
# NSG OUTBOUND RULE ANALYSIS
# ============================================================
#
# Required modules:
# Install-Module Az -Scope CurrentUser
# Install-Module ImportExcel -Scope CurrentUser -Force
#
# This script is read-only. It does not modify any NSG.
# ============================================================

$defaultOnlyReport      = @()
$customAndDefaultReport = @()
$errorReport            = @()

# ============================================================
# FUNCTIONS
# ============================================================

function ConvertTo-Text {
    param (
        $MultipleValues,
        $SingleValue
    )

    if ($null -ne $MultipleValues) {
        $values = @($MultipleValues)

        if ($values.Count -gt 0) {
            return (
                $values |
                ForEach-Object { "$_" }
            ) -join "; "
        }
    }

    if ($null -ne $SingleValue) {
        return "$SingleValue"
    }

    return ""
}

function New-RuleReportRow {
    param (
        $Subscription,
        $NSG,
        $Rule,
        [string]$RuleType,
        [string]$ConnectedSubnets,
        [string]$ConnectedNICs
    )

    $source = ConvertTo-Text `
        -MultipleValues $Rule.SourceAddressPrefixes `
        -SingleValue $Rule.SourceAddressPrefix

    $sourcePorts = ConvertTo-Text `
        -MultipleValues $Rule.SourcePortRanges `
        -SingleValue $Rule.SourcePortRange

    $destination = ConvertTo-Text `
        -MultipleValues $Rule.DestinationAddressPrefixes `
        -SingleValue $Rule.DestinationAddressPrefix

    $destinationPorts = ConvertTo-Text `
        -MultipleValues $Rule.DestinationPortRanges `
        -SingleValue $Rule.DestinationPortRange

    return [PSCustomObject]@{
        SubscriptionName = $Subscription.Name
        ResourceGroup    = $NSG.ResourceGroupName
        NSGName          = $NSG.Name
        ConnectedSubnets = $ConnectedSubnets
        ConnectedNICs    = $ConnectedNICs
        RuleType         = $RuleType
        RuleName         = $Rule.Name
        Priority         = $Rule.Priority
        Direction        = $Rule.Direction
        Access           = $Rule.Access
        Protocol         = $Rule.Protocol
        Source           = $source
        SourcePorts      = $sourcePorts
        Destination      = $destination
        DestinationPorts = $destinationPorts
    }
}

# ============================================================
# GET SUBSCRIPTIONS
# ============================================================

try {
    $subscriptions = @(
        Get-AzSubscription -ErrorAction Stop |
        Where-Object { $_.State -eq "Enabled" }
    )

    if ($subscriptions.Count -eq 0) {
        throw "No enabled subscriptions were found."
    }

    Write-Host "Enabled subscriptions found: $($subscriptions.Count)" `
        -ForegroundColor Green
}
catch {
    Write-Error "Unable to retrieve subscriptions: $($_.Exception.Message)"
    return
}

# ============================================================
# COLLECT NSG INFORMATION
# ============================================================

foreach ($subscription in $subscriptions) {

    Write-Host ""
    Write-Host "Checking subscription: $($subscription.Name)" `
        -ForegroundColor Cyan

    try {
        Set-AzContext `
            -SubscriptionId $subscription.Id `
            -ErrorAction Stop | Out-Null

        $nsgs = @(
            Get-AzNetworkSecurityGroup -ErrorAction Stop
        )

        Write-Host "NSGs found: $($nsgs.Count)"
    }
    catch {
        $message = $_.Exception.Message

        Write-Warning `
            "Subscription failed: $($subscription.Name) - $message"

        $errorReport += [PSCustomObject]@{
            SubscriptionName = $subscription.Name
            ResourceGroup    = ""
            NSGName          = ""
            ErrorType        = "Subscription"
            ErrorMessage     = $message
        }

        continue
    }

    foreach ($nsg in $nsgs) {

        try {
            # --------------------------------------------
            # Connected subnets
            # --------------------------------------------

            $connectedSubnets = @(
                $nsg.Subnets |
                ForEach-Object {

                    if ([string]::IsNullOrWhiteSpace($_.Id)) {
                        return
                    }

                    $parts = $_.Id -split "/"

                    if ($parts.Count -gt 10) {
                        $vnetName   = $parts[8]
                        $subnetName = $parts[10]

                        "$vnetName/$subnetName"
                    }
                    else {
                        $_.Id
                    }
                }
            )

            $subnetList = $connectedSubnets -join "; "

            # --------------------------------------------
            # Connected NICs
            # --------------------------------------------

            $connectedNICs = @(
                $nsg.NetworkInterfaces |
                ForEach-Object {

                    if (-not [string]::IsNullOrWhiteSpace($_.Id)) {
                        ($_.Id -split "/")[-1]
                    }
                }
            )

            $nicList = $connectedNICs -join "; "

            # --------------------------------------------
            # Custom outbound rules
            # --------------------------------------------

            $customOutboundRules = @(
                $nsg.SecurityRules |
                Where-Object {
                    $_.Direction -eq "Outbound"
                }
            )

            # --------------------------------------------
            # Azure default outbound rules
            # --------------------------------------------

            $defaultOutboundRules = @(
                $nsg.DefaultSecurityRules |
                Where-Object {
                    $_.Direction -eq "Outbound"
                }
            )

            # --------------------------------------------
            # Default outbound only
            # --------------------------------------------

            if ($customOutboundRules.Count -eq 0) {

                foreach ($rule in $defaultOutboundRules) {

                    $defaultOnlyReport += New-RuleReportRow `
                        -Subscription $subscription `
                        -NSG $nsg `
                        -Rule $rule `
                        -RuleType "Default" `
                        -ConnectedSubnets $subnetList `
                        -ConnectedNICs $nicList
                }
            }

            # --------------------------------------------
            # Custom outbound rules exist
            # Add both custom and default outbound rules
            # --------------------------------------------

            else {
                foreach ($rule in $customOutboundRules) {

                    $customAndDefaultReport += New-RuleReportRow `
                        -Subscription $subscription `
                        -NSG $nsg `
                        -Rule $rule `
                        -RuleType "Custom" `
                        -ConnectedSubnets $subnetList `
                        -ConnectedNICs $nicList
                }

                foreach ($rule in $defaultOutboundRules) {

                    $customAndDefaultReport += New-RuleReportRow `
                        -Subscription $subscription `
                        -NSG $nsg `
                        -Rule $rule `
                        -RuleType "Default" `
                        -ConnectedSubnets $subnetList `
                        -ConnectedNICs $nicList
                }
            }
        }
        catch {
            $message = $_.Exception.Message

            Write-Warning `
                "NSG failed: $($nsg.Name) - $message"

            $errorReport += [PSCustomObject]@{
                SubscriptionName = $subscription.Name
                ResourceGroup    = $nsg.ResourceGroupName
                NSGName          = $nsg.Name
                ErrorType        = "NSG"
                ErrorMessage     = $message
            }
        }
    }
}

# ============================================================
# BUILD UNIQUE NSG LISTS
# ============================================================

$defaultNSGs = @(
    $defaultOnlyReport |
    Select-Object `
        SubscriptionName,
        ResourceGroup,
        NSGName `
        -Unique |
    ForEach-Object {
        [PSCustomObject]@{
            SubscriptionName = $_.SubscriptionName
            ResourceGroup    = $_.ResourceGroup
            NSGName          = $_.NSGName
            Classification   = "Default"
        }
    }
)

$customNSGs = @(
    $customAndDefaultReport |
    Where-Object {
        $_.RuleType -eq "Custom"
    } |
    Select-Object `
        SubscriptionName,
        ResourceGroup,
        NSGName `
        -Unique |
    ForEach-Object {
        [PSCustomObject]@{
            SubscriptionName = $_.SubscriptionName
            ResourceGroup    = $_.ResourceGroup
            NSGName          = $_.NSGName
            Classification   = "Custom"
        }
    }
)

$allNSGs = @($defaultNSGs) + @($customNSGs)

# ============================================================
# OVERALL SUMMARY
# ============================================================

$totalNSGCount = $allNSGs.Count

$defaultNSGCount = @(
    $allNSGs |
    Where-Object {
        $_.Classification -eq "Default"
    }
).Count

$customNSGCount = @(
    $allNSGs |
    Where-Object {
        $_.Classification -eq "Custom"
    }
).Count

$nsgSummary = @(
    [PSCustomObject]@{
        Scope            = "Overall"
        SubscriptionName = "ALL SUBSCRIPTIONS"
        TotalNSGs        = $totalNSGCount
        DefaultNSGs      = $defaultNSGCount
        CustomNSGs       = $customNSGCount
    }
)

# ============================================================
# SUBSCRIPTION-WISE SUMMARY
# Includes subscriptions with zero NSGs
# ============================================================

$subscriptionSummary = @(
    foreach ($subscription in $subscriptions) {

        $subscriptionNSGs = @(
            $allNSGs |
            Where-Object {
                $_.SubscriptionName -eq $subscription.Name
            }
        )

        $subscriptionDefault = @(
            $subscriptionNSGs |
            Where-Object {
                $_.Classification -eq "Default"
            }
        ).Count

        $subscriptionCustom = @(
            $subscriptionNSGs |
            Where-Object {
                $_.Classification -eq "Custom"
            }
        ).Count

        [PSCustomObject]@{
            Scope            = "Subscription"
            SubscriptionName = $subscription.Name
            TotalNSGs        = $subscriptionNSGs.Count
            DefaultNSGs      = $subscriptionDefault
            CustomNSGs       = $subscriptionCustom
        }
    }
)

$nsgSummary += @(
    $subscriptionSummary |
    Sort-Object SubscriptionName
)

# ============================================================
# CREATE EXCEL REPORT
# ============================================================

$excelPath = Join-Path $PWD "NSG-Outbound-Analysis.xlsx"

if (Test-Path $excelPath) {
    Remove-Item $excelPath -Force
}

try {
    # --------------------------------------------
    # Worksheet 1: Summary
    # --------------------------------------------

    $nsgSummary |
        Export-Excel `
            -Path $excelPath `
            -WorksheetName "NSG Summary" `
            -TableName "NSGSummary" `
            -TableStyle Medium4 `
            -AutoSize `
            -AutoFilter `
            -FreezeTopRow `
            -BoldTopRow

    # --------------------------------------------
    # Worksheet 2: Default outbound only
    # --------------------------------------------

    if ($defaultOnlyReport.Count -gt 0) {

        $defaultOnlyReport |
            Sort-Object `
                SubscriptionName,
                ResourceGroup,
                NSGName,
                Priority |
            Export-Excel `
                -Path $excelPath `
                -WorksheetName "Default Outbound Only" `
                -TableName "DefaultOutboundNSGs" `
                -TableStyle Medium4 `
                -AutoSize `
                -AutoFilter `
                -FreezeTopRow `
                -BoldTopRow `
                -Append
    }

    # --------------------------------------------
    # Worksheet 3: Custom and default rules
    # --------------------------------------------

    if ($customAndDefaultReport.Count -gt 0) {

        $customAndDefaultReport |
            Sort-Object `
                SubscriptionName,
                ResourceGroup,
                NSGName,
                Priority |
            Export-Excel `
                -Path $excelPath `
                -WorksheetName "Custom and Default Rules" `
                -TableName "CustomDefaultNSGs" `
                -TableStyle Medium4 `
                -AutoSize `
                -AutoFilter `
                -FreezeTopRow `
                -BoldTopRow `
                -Append
    }

    # --------------------------------------------
    # Worksheet 4: Errors
    # Created only when errors exist
    # --------------------------------------------

    if ($errorReport.Count -gt 0) {

        $errorReport |
            Export-Excel `
                -Path $excelPath `
                -WorksheetName "Errors" `
                -TableName "NSGErrors" `
                -TableStyle Medium4 `
                -AutoSize `
                -AutoFilter `
                -FreezeTopRow `
                -BoldTopRow `
                -Append
    }

    # --------------------------------------------
    # Keep colour only on headings
    # Remove alternating row colours
    # --------------------------------------------

    $excelPackage = Open-ExcelPackage -Path $excelPath

    foreach ($worksheet in $excelPackage.Workbook.Worksheets) {

        foreach ($table in $worksheet.Tables) {
            $table.ShowRowStripes    = $false
            $table.ShowColumnStripes = $false
            $table.ShowFirstColumn   = $false
            $table.ShowLastColumn    = $false
        }
    }

    Close-ExcelPackage $excelPackage

    Write-Host ""
    Write-Host "========================================" `
        -ForegroundColor Green
    Write-Host "Report completed successfully" `
        -ForegroundColor Green
    Write-Host "========================================" `
        -ForegroundColor Green

    Write-Host "Excel file: $excelPath"
    Write-Host "Total NSGs: $totalNSGCount"
    Write-Host "Default NSGs: $defaultNSGCount"
    Write-Host "Custom NSGs: $customNSGCount"
    Write-Host "Errors: $($errorReport.Count)"
}
catch {
    Write-Error "Excel report creation failed: $($_.Exception.Message)"
}

# ============================================================
# NSG OUTBOUND RULE ANALYSIS - CUSTODIAN WORKBOOK
# ============================================================
# Required modules:
#   Install-Module Az -Scope CurrentUser
#   Install-Module ImportExcel -Scope CurrentUser -Force
#
# Read-only: this script does not modify or delete any NSG.
# ============================================================

$nsgInventory = @()
$ruleReport    = @()
$errorReport   = @()

function ConvertTo-Text {
    param($MultipleValues, $SingleValue)

    if ($null -ne $MultipleValues) {
        $values = @($MultipleValues)
        if ($values.Count -gt 0) {
            return ($values | ForEach-Object { "$_" }) -join "; "
        }
    }

    if ($null -ne $SingleValue) {
        return "$SingleValue"
    }

    return ""
}

function Get-SubscriptionMetadata {
    param([string]$SubscriptionName)

    $parts = @($SubscriptionName -split "_" | Where-Object { $_ })
    $environment = if ($parts.Count -gt 0) { $parts[0].ToUpperInvariant() } else { "UNKNOWN" }
    $custodian   = if ($parts.Count -gt 1) { $parts[-1] } else { $SubscriptionName }

    [PSCustomObject]@{
        Environment = $environment
        Custodian   = $custodian
    }
}

function Get-SafeWorksheetName {
    param(
        [string]$RequestedName,
        [hashtable]$UsedNames
    )

    $name = $RequestedName -replace '[:\\/\?\*\[\]]', '_'
    $name = $name.Trim()
    if ([string]::IsNullOrWhiteSpace($name)) { $name = "Custodian" }
    if ($name.Length -gt 31) { $name = $name.Substring(0, 31) }

    $baseName = $name
    $counter = 2
    while ($UsedNames.ContainsKey($name.ToLowerInvariant())) {
        $suffix = "_$counter"
        $maxBaseLength = 31 - $suffix.Length
        $trimmedBase = if ($baseName.Length -gt $maxBaseLength) {
            $baseName.Substring(0, $maxBaseLength)
        } else {
            $baseName
        }
        $name = "$trimmedBase$suffix"
        $counter++
    }

    $UsedNames[$name.ToLowerInvariant()] = $true
    return $name
}

function New-RuleReportRow {
    param(
        $Subscription,
        $Metadata,
        $NSG,
        $Rule,
        [string]$Classification,
        [string]$RuleType,
        [string]$ConnectedSubnets,
        [string]$ConnectedNICs
    )

    [PSCustomObject]@{
        SubscriptionName = $Subscription.Name
        Environment      = $Metadata.Environment
        Custodian        = $Metadata.Custodian
        ResourceGroup    = $NSG.ResourceGroupName
        NSGName          = $NSG.Name
        ConnectedSubnets = $ConnectedSubnets
        ConnectedNICs    = $ConnectedNICs
        Classification   = $Classification
        RuleType         = $RuleType
        RuleName         = $Rule.Name
        Priority         = $Rule.Priority
        Direction        = $Rule.Direction
        Access           = $Rule.Access
        Protocol         = $Rule.Protocol
        Source           = ConvertTo-Text $Rule.SourceAddressPrefixes $Rule.SourceAddressPrefix
        SourcePorts      = ConvertTo-Text $Rule.SourcePortRanges $Rule.SourcePortRange
        Destination      = ConvertTo-Text $Rule.DestinationAddressPrefixes $Rule.DestinationAddressPrefix
        DestinationPorts = ConvertTo-Text $Rule.DestinationPortRanges $Rule.DestinationPortRange
    }
}

function Write-WorksheetSection {
    param(
        $Worksheet,
        [int]$StartRow,
        [string]$Title,
        [array]$Rows,
        [string[]]$Columns,
        [string]$TableName
    )

    $Worksheet.SetValue($StartRow, 1, $Title)
    $Worksheet.Cells[$StartRow, 1, $StartRow, $Columns.Count].Merge = $true
    $Worksheet.Cells[$StartRow, 1, $StartRow, $Columns.Count].Style.Font.Bold = $true
    $Worksheet.Cells[$StartRow, 1, $StartRow, $Columns.Count].Style.Font.Color.SetColor([System.Drawing.Color]::White)
    $Worksheet.Cells[$StartRow, 1, $StartRow, $Columns.Count].Style.Fill.PatternType = "Solid"
    $Worksheet.Cells[$StartRow, 1, $StartRow, $Columns.Count].Style.Fill.BackgroundColor.SetColor([System.Drawing.Color]::FromArgb(112, 48, 160))

    $headerRow = $StartRow + 1
    for ($columnIndex = 0; $columnIndex -lt $Columns.Count; $columnIndex++) {
        $Worksheet.SetValue($headerRow, $columnIndex + 1, $Columns[$columnIndex])
    }

    $Worksheet.Cells[$headerRow, 1, $headerRow, $Columns.Count].Style.Font.Bold = $true
    $Worksheet.Cells[$headerRow, 1, $headerRow, $Columns.Count].Style.Fill.PatternType = "Solid"
    $Worksheet.Cells[$headerRow, 1, $headerRow, $Columns.Count].Style.Fill.BackgroundColor.SetColor([System.Drawing.Color]::FromArgb(217, 210, 233))

    if ($Rows.Count -eq 0) {
        $Worksheet.SetValue($headerRow + 1, 1, "No records")
        return ($headerRow + 3)
    }

    $dataRow = $headerRow + 1
    foreach ($item in $Rows) {
        for ($columnIndex = 0; $columnIndex -lt $Columns.Count; $columnIndex++) {
            $propertyName = $Columns[$columnIndex]
            $Worksheet.SetValue($dataRow, $columnIndex + 1, $item.$propertyName)
        }
        $dataRow++
    }

    $tableRange = $Worksheet.Cells[$headerRow, 1, $dataRow - 1, $Columns.Count]
    $table = $Worksheet.Tables.Add($tableRange, $TableName)
    $table.TableStyle = "Medium4"
    $table.ShowRowStripes = $false
    $table.ShowColumnStripes = $false

    return ($dataRow + 1)
}

# ============================================================
# GET SUBSCRIPTIONS
# ============================================================

try {
    $subscriptions = @(
        Get-AzSubscription -ErrorAction Stop |
        Where-Object { $_.State -eq "Enabled" }
    )

    if ($subscriptions.Count -eq 0) {
        throw "No enabled subscriptions were found."
    }

    Write-Host "Enabled subscriptions found: $($subscriptions.Count)" -ForegroundColor Green
}
catch {
    Write-Error "Unable to retrieve subscriptions: $($_.Exception.Message)"
    return
}

# ============================================================
# COLLECT AND CLASSIFY NSGS
# ============================================================

foreach ($subscription in $subscriptions) {
    $metadata = Get-SubscriptionMetadata $subscription.Name

    Write-Host ""
    Write-Host "Checking: $($subscription.Name)" -ForegroundColor Cyan

    try {
        Set-AzContext -SubscriptionId $subscription.Id -ErrorAction Stop | Out-Null
        $nsgs = @(Get-AzNetworkSecurityGroup -ErrorAction Stop)
        Write-Host "NSGs found: $($nsgs.Count)"
    }
    catch {
        $message = $_.Exception.Message
        Write-Warning "Subscription failed: $($subscription.Name) - $message"

        $errorReport += [PSCustomObject]@{
            SubscriptionName = $subscription.Name
            Environment      = $metadata.Environment
            Custodian        = $metadata.Custodian
            ResourceGroup    = ""
            NSGName          = ""
            ErrorType        = "Subscription"
            ErrorMessage     = $message
        }
        continue
    }

    foreach ($nsg in $nsgs) {
        try {
            $connectedSubnets = @(
                $nsg.Subnets | ForEach-Object {
                    if (-not [string]::IsNullOrWhiteSpace($_.Id)) {
                        $parts = $_.Id -split "/"
                        if ($parts.Count -gt 10) {
                            "$($parts[8])/$($parts[10])"
                        } else {
                            $_.Id
                        }
                    }
                }
            )

            $connectedNICs = @(
                $nsg.NetworkInterfaces | ForEach-Object {
                    if (-not [string]::IsNullOrWhiteSpace($_.Id)) {
                        ($_.Id -split "/")[-1]
                    }
                }
            )

            $subnetList = $connectedSubnets -join "; "
            $nicList    = $connectedNICs -join "; "

            $customOutboundRules = @(
                $nsg.SecurityRules | Where-Object { $_.Direction -eq "Outbound" }
            )

            $defaultOutboundRules = @(
                $nsg.DefaultSecurityRules | Where-Object { $_.Direction -eq "Outbound" }
            )

            $isUnattached = ($connectedSubnets.Count -eq 0 -and $connectedNICs.Count -eq 0)
            $classification = if ($isUnattached) {
                "Unattached"
            } elseif ($customOutboundRules.Count -gt 0) {
                "Custom"
            } else {
                "Default"
            }

            $nsgInventory += [PSCustomObject]@{
                SubscriptionName   = $subscription.Name
                Environment        = $metadata.Environment
                Custodian          = $metadata.Custodian
                ResourceGroup      = $nsg.ResourceGroupName
                NSGName            = $nsg.Name
                ConnectedSubnets   = $subnetList
                ConnectedNICs      = $nicList
                Classification     = $classification
                CustomOutboundRuleCount = $customOutboundRules.Count
                Status             = if ($isUnattached) { "Deletion Candidate - Validate First" } else { "In Use" }
            }

            # Unattached NSGs are listed once and not repeated in Default/Custom sections.
            if (-not $isUnattached) {
                if ($classification -eq "Default") {
                    foreach ($rule in $defaultOutboundRules) {
                        $ruleReport += New-RuleReportRow $subscription $metadata $nsg $rule `
                            "Default" "Default" $subnetList $nicList
                    }
                }
                else {
                    foreach ($rule in $customOutboundRules) {
                        $ruleReport += New-RuleReportRow $subscription $metadata $nsg $rule `
                            "Custom" "Custom" $subnetList $nicList
                    }

                    # Retain Azure default rows underneath custom NSGs for full visibility.
                    foreach ($rule in $defaultOutboundRules) {
                        $ruleReport += New-RuleReportRow $subscription $metadata $nsg $rule `
                            "Custom" "Default" $subnetList $nicList
                    }
                }
            }
        }
        catch {
            $message = $_.Exception.Message
            Write-Warning "NSG failed: $($nsg.Name) - $message"

            $errorReport += [PSCustomObject]@{
                SubscriptionName = $subscription.Name
                Environment      = $metadata.Environment
                Custodian        = $metadata.Custodian
                ResourceGroup    = $nsg.ResourceGroupName
                NSGName          = $nsg.Name
                ErrorType        = "NSG"
                ErrorMessage     = $message
            }
        }
    }
}

# ============================================================
# BUILD SUMMARY - OVERALL + EVERY SUBSCRIPTION
# ============================================================

$summaryRows = @(
    [PSCustomObject]@{
        Scope            = "Overall"
        SubscriptionName = "ALL SUBSCRIPTIONS"
        Environment      = "ALL"
        Custodian        = "ALL"
        TotalNSGs        = $nsgInventory.Count
        UnattachedNSGs   = @($nsgInventory | Where-Object Classification -eq "Unattached").Count
        DefaultNSGs      = @($nsgInventory | Where-Object Classification -eq "Default").Count
        CustomNSGs       = @($nsgInventory | Where-Object Classification -eq "Custom").Count
        Errors           = $errorReport.Count
    }
)

foreach ($subscription in ($subscriptions | Sort-Object Name)) {
    $metadata = Get-SubscriptionMetadata $subscription.Name
    $subscriptionNSGs = @($nsgInventory | Where-Object SubscriptionName -eq $subscription.Name)
    $subscriptionErrors = @($errorReport | Where-Object SubscriptionName -eq $subscription.Name)

    $summaryRows += [PSCustomObject]@{
        Scope            = "Subscription"
        SubscriptionName = $subscription.Name
        Environment      = $metadata.Environment
        Custodian        = $metadata.Custodian
        TotalNSGs        = $subscriptionNSGs.Count
        UnattachedNSGs   = @($subscriptionNSGs | Where-Object Classification -eq "Unattached").Count
        DefaultNSGs      = @($subscriptionNSGs | Where-Object Classification -eq "Default").Count
        CustomNSGs       = @($subscriptionNSGs | Where-Object Classification -eq "Custom").Count
        Errors           = $subscriptionErrors.Count
    }
}

# ============================================================
# CREATE WORKBOOK
# ============================================================

$excelPath = Join-Path $PWD "NSG-Outbound-Analysis-By-Custodian.xlsx"
if (Test-Path $excelPath) { Remove-Item $excelPath -Force }

try {
    $summaryRows |
        Export-Excel -Path $excelPath `
            -WorksheetName "Summary" `
            -TableName "NSGSummary" `
            -TableStyle Medium4 `
            -AutoFilter -FreezeTopRow -BoldTopRow

    $package = Open-ExcelPackage -Path $excelPath
    $usedSheetNames = @{ "summary" = $true; "errors" = $true }
    $tableCounter = 1

    $unattachedColumns = @(
        "SubscriptionName", "ResourceGroup", "NSGName",
        "ConnectedSubnets", "ConnectedNICs", "Status"
    )

    $ruleColumns = @(
        "SubscriptionName", "ResourceGroup", "NSGName",
        "ConnectedSubnets", "ConnectedNICs", "RuleType", "RuleName",
        "Priority", "Direction", "Access", "Protocol", "Source",
        "SourcePorts", "Destination", "DestinationPorts"
    )

    $custodians = @(
        @($nsgInventory.Custodian) + @($errorReport.Custodian) |
        Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
        Sort-Object -Unique
    )

    foreach ($custodian in $custodians) {
        $sheetName = Get-SafeWorksheetName $custodian $usedSheetNames
        $worksheet = $package.Workbook.Worksheets.Add($sheetName)
        $currentRow = 1

        $custodianEnvironments = @(
            @($nsgInventory | Where-Object Custodian -eq $custodian).Environment +
            @($errorReport | Where-Object Custodian -eq $custodian).Environment |
            Where-Object { -not [string]::IsNullOrWhiteSpace($_) } |
            Sort-Object -Unique
        )

        $orderedEnvironments = @(
            $custodianEnvironments |
            Sort-Object @{ Expression = {
                switch ($_) {
                    "DEV"  { 1 }
                    "PROD" { 2 }
                    default { 3 }
                }
            } }, @{ Expression = { $_ } }
        )

        foreach ($environment in $orderedEnvironments) {
            $worksheet.SetValue($currentRow, 1, "$environment - $custodian")
            $worksheet.Cells[$currentRow, 1, $currentRow, $ruleColumns.Count].Merge = $true
            $worksheet.Cells[$currentRow, 1, $currentRow, $ruleColumns.Count].Style.Font.Bold = $true
            $worksheet.Cells[$currentRow, 1, $currentRow, $ruleColumns.Count].Style.Font.Size = 14
            $currentRow += 2

            $unattachedRows = @(
                $nsgInventory |
                Where-Object {
                    $_.Custodian -eq $custodian -and
                    $_.Environment -eq $environment -and
                    $_.Classification -eq "Unattached"
                } |
                Sort-Object SubscriptionName, ResourceGroup, NSGName
            )

            $defaultRows = @(
                $ruleReport |
                Where-Object {
                    $_.Custodian -eq $custodian -and
                    $_.Environment -eq $environment -and
                    $_.Classification -eq "Default"
                } |
                Sort-Object SubscriptionName, ResourceGroup, NSGName, Priority
            )

            $customRows = @(
                $ruleReport |
                Where-Object {
                    $_.Custodian -eq $custodian -and
                    $_.Environment -eq $environment -and
                    $_.Classification -eq "Custom"
                } |
                Sort-Object SubscriptionName, ResourceGroup, NSGName, Priority
            )

            $currentRow = Write-WorksheetSection $worksheet $currentRow `
                "$environment - Unattached NSGs" $unattachedRows $unattachedColumns `
                "Table_$($tableCounter)_Unattached"
            $tableCounter++

            $currentRow = Write-WorksheetSection $worksheet $currentRow `
                "$environment - Default Outbound Only" $defaultRows $ruleColumns `
                "Table_$($tableCounter)_Default"
            $tableCounter++

            $currentRow = Write-WorksheetSection $worksheet $currentRow `
                "$environment - Custom and Default Outbound Rules" $customRows $ruleColumns `
                "Table_$($tableCounter)_Custom"
            $tableCounter++

            $currentRow += 2
        }

        $worksheet.View.FreezePanes(2, 1)

        # Fixed widths are used because AutoFit is unavailable in Azure Cloud Shell/Linux.
        for ($column = 1; $column -le $worksheet.Dimension.End.Column; $column++) {
            $worksheet.Column($column).Width = if ($column -in @(1, 2, 3, 4, 5, 7, 12, 14)) { 32 } else { 16 }
        }
    }

    if ($errorReport.Count -gt 0) {
        $errorSheet = $package.Workbook.Worksheets.Add("Errors")
        $errorColumns = @(
            "SubscriptionName", "Environment", "Custodian", "ResourceGroup",
            "NSGName", "ErrorType", "ErrorMessage"
        )
        [void](Write-WorksheetSection $errorSheet 1 "Collection Errors" `
            $errorReport $errorColumns "Table_$($tableCounter)_Errors")
        for ($column = 1; $column -le $errorSheet.Dimension.End.Column; $column++) {
            $errorSheet.Column($column).Width = if ($column -eq 7) { 60 } else { 24 }
        }
    }

    foreach ($table in $package.Workbook.Worksheets["Summary"].Tables) {
        $table.ShowRowStripes = $false
        $table.ShowColumnStripes = $false
    }

    Close-ExcelPackage $package

    Write-Host ""
    Write-Host "Report completed successfully" -ForegroundColor Green
    Write-Host "Excel file: $excelPath"
    Write-Host "Total NSGs: $($nsgInventory.Count)"
    Write-Host "Unattached: $(@($nsgInventory | Where-Object Classification -eq 'Unattached').Count)"
    Write-Host "Default: $(@($nsgInventory | Where-Object Classification -eq 'Default').Count)"
    Write-Host "Custom: $(@($nsgInventory | Where-Object Classification -eq 'Custom').Count)"
    Write-Host "Custodian sheets: $($custodians.Count)"
    Write-Host "Errors: $($errorReport.Count)"
}
catch {
    if ($null -ne $package) {
        try { Close-ExcelPackage $package -NoSave } catch {}
    }
    Write-Error "Excel report creation failed: $($_.Exception.Message)"
}

union isfuzzy=true
(
    NTANetAnalytics
    | where SubType =~ "FlowLog"
    | where FlowStartTime >= ago(45d)
    | where FlowDirection =~ "Outbound"
    | where FlowStatus =~ "Allowed"
    | extend
        LogType       = "VNet Flow Log",
        EventTime     = FlowStartTime,
        NSGName       = iff(isnotempty(AclGroup), AclGroup, NsgList),
        RuleName      = iff(isnotempty(AclRule), AclRule, NsgRule),
        SourceIP      = SrcIp,
        SourceSubnet  = SrcSubnet,
        DestinationIP = iff(isnotempty(DestIp), DestIp, DestPublicIps),
        Destination   = coalesce(DestServiceName, DestServiceTags, DestIp, DestPublicIps),
        DestinationPort = tostring(DestPort),
        Protocol      = L4Protocol,
        FlowCategory  = FlowType,
        ResourceId    = TargetResourceId,
        FlowCount     = AllowedOutFlows,
        TotalBytes    = BytesSrcToDest
    | project LogType, EventTime, NSGName, RuleName, SourceIP,
              SourceSubnet, DestinationIP, Destination,
              DestinationPort, Protocol, FlowCategory,
              ResourceId, FlowCount, TotalBytes
),
(
    AzureNetworkAnalytics_CL
    | where SubType_s == "FlowLog"
    | where FlowStartTime_t >= ago(45d)
    | where FlowDirection_s == "O"
    | where FlowStatus_s == "A"
    | extend
        LogType       = "Legacy NSG Flow Log",
        EventTime     = FlowStartTime_t,
        NSGName       = NSGList_s,
        RuleName      = NSGRule_s,
        SourceIP      = SrcIP_s,
        SourceSubnet  = Subnet1_s,
        DestinationIP = iff(isnotempty(DestIP_s), DestIP_s, DestPublicIPs_s),
        Destination   = iff(isnotempty(DestIP_s), DestIP_s, DestPublicIPs_s),
        DestinationPort = tostring(DestPort_d),
        Protocol      = L4Protocol_s,
        FlowCategory  = FlowType_s,
        ResourceId    = NSGList_s,
        FlowCount     = AllowedOutFlows_d,
        TotalBytes    = OutboundBytes_d
    | project LogType, EventTime, NSGName, RuleName, SourceIP,
              SourceSubnet, DestinationIP, Destination,
              DestinationPort, Protocol, FlowCategory,
              ResourceId, FlowCount, TotalBytes
)
| summarize
    FirstSeen       = min(EventTime),
    LastSeen        = max(EventTime),
    TotalFlowCount  = sum(FlowCount),
    TotalBytes      = sum(TotalBytes)
    by LogType, NSGName, RuleName, SourceSubnet, SourceIP,
       DestinationIP, Destination, DestinationPort,
       Protocol, FlowCategory, ResourceId
| order by NSGName asc, TotalFlowCount desc
